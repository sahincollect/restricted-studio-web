# Restricted Studio — Environment Variables Template
# Copy to .env.local for development or configure in Vercel Project Settings (Production/Preview).

# Public Site & Strict CORS Allowlist
NEXT_PUBLIC_SITE_URL=https://restrictedstudio.shop
ALLOWED_ORIGINS=https://restrictedstudio.shop,https://www.restrictedstudio.shop

# Supabase (Auth & PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://nknscxscbnucqrxqbgfg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Customer HttpOnly Session Signing (32+ bytes random hex/base64; falls back to ADMIN_SESSION_SECRET if unset)
CUSTOMER_SESSION_SECRET=replace_with_random_64_char_hex_string

# Zero-Trust Admin Panel Authentication & TOTP 2FA
ADMIN_USERNAME=your_admin_username
# Provide EITHER Argon2id hash (recommended: ADMIN_PASSWORD_HASH) OR strong ADMIN_PASSWORD:
ADMIN_PASSWORD=your_strong_admin_password
# ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=3,p=1$...
ADMIN_SESSION_SECRET=replace_with_different_64_char_hex_string
# Persistent Base32 TOTP secret (20 bytes / 32 chars Base32) for serverless 2FA persistence:
# ADMIN_TOTP_SECRET=YOURBASE32TOTPSECRETKEY
# Optional CLI secret header (x-admin-secret) for automated operations:
ADMIN_SECRET_KEY=replace_with_32_plus_char_secret
# Optional Zero-Trust Admin Network Isolation:
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
# ADMIN_SUBDOMAIN=admin.restrictedstudio.shop
# ADMIN_EMAIL=admin@restrictedstudio.shop

# Cloudflare Turnstile Bot Protection & Origin Lock
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
# CLOUDFLARE_ORIGIN_SECRET=replace_with_cloudflare_transform_header_secret

# Hosted Desktop Setup Download URL (served only to licensed customers via /api/download)
R_AI_DOWNLOAD_URL=https://your-host/Restricted_Studio_Setup.exe

# Optional Read-Only UptimeRobot API Key (adds 24h/7d/30d/90d history to /status)
# UPTIMEROBOT_API_KEY=ur_readonly_key_here
